{
    "slug": "lms_finance",
    "name": "Fee Subscriptions, Razorpay & Receipts",
    "category": "core_lms",
    "version": "14.0.0",
    "author": "Core Architecture Team",
    "description": "Zero-Latency Family Fee Portal, 100% Real Razorpay HMAC-SHA256 Integration, IST Timezone Accuracy, Permanent Print/PDF Receipt Access, and Clean UTF-8 Rendering.",
    "admin_route": "addons/lms-finance",
    "frontend_route": "finance/portal",
    "init_model": "App\\Models\\Addons\\LmsFinance\\LmsFinanceModel",
    "assets": {
        "css": ["addons/lms-finance/assets/lms_finance.css"],
        "js": ["addons/lms-finance/assets/lms_finance.js"]
    },
    "default_config": { "grace_period_days": "5" },
    "permissions": [
        { "key": "lms_finance.view",     "label": "View Family Fee Subscriptions & Official Receipts [Parent + Student + Admin]" },
        { "key": "lms_finance.collect",  "label": "Verify Offline Proofs, Manage Subscriptions & Custom Billing [Super Admin + Admin]" },
        { "key": "lms_finance.expenses", "label": "Manage Teacher Payroll, Salary Slips & Academy Expenses [Super Admin + Admin + Teacher]" },
        { "key": "lms_finance.settings", "label": "Configure Razorpay Test/Live Keys & Receipt Designer [Super Admin + Admin]" },
        { "key": "lms_finance.delete",   "label": "Delete Invoices, Transactions & Expense Entries [Super Admin + Admin]" }
    ],
    "sub_views": [
        { "key": "lfn.ledger",         "label": "Transactions & Approvals",   "route": "addons/lms-finance",                "icon": "💳", "permission": "lms_finance.collect" },
        { "key": "lfn.invoices",       "label": "Subscriptions & Locks",      "route": "addons/lms-finance/invoices",       "icon": "🧾", "permission": "lms_finance.collect" },
        { "key": "lfn.custom_billing", "label": "Custom Parent Billing",      "route": "addons/lms-finance/custom-billing", "icon": "➕", "permission": "lms_finance.collect" },
        { "key": "lfn.payouts",        "label": "Teacher Payroll & Expenses", "route": "addons/lms-finance/payouts",        "icon": "💵", "permission": "lms_finance.expenses" },
        { "key": "lfn.settings",       "label": "Razorpay & Receipt Design",  "route": "addons/lms-finance/settings",       "icon": "⚙",  "permission": "lms_finance.settings" },
        { "key": "lfn.portal",         "label": "Family Fee Portal",          "route": "finance/portal",                    "icon": "👪", "permission": "lms_finance.view" }
    ]
}
