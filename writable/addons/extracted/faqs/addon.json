{
    "slug": "faqs",
    "name": "Dynamic FAQ Accordion",
    "category": "cms_widget",
    "version": "2.1.0",
    "author": "Core Architecture Team",
    "description": "Self-contained FAQ accordion add-on with external CSS/JS assets, category filtering, alignment controls, and Google FAQPage SEO Schema.",
    "admin_route": "addons/faqs",
    "frontend_route": "",
    "init_model": "App\\Models\\Addons\\Faqs\\FaqModel",
    "assets": {
        "css": ["addons/faqs/assets/faq.css"],
        "js": ["addons/faqs/assets/faq.js"]
    },
    "default_config": {
        "color_mode": "auto",
        "card_bg_dark": "#171a26",
        "text_dark": "#f8fafc",
        "accent_dark": "#10b981",
        "card_bg_light": "#ffffff",
        "text_light": "#0f172a",
        "accent_light": "#059669",
        "default_category": "General",
        "expand_first": "1",
        "box_position": "center",
        "text_align": "left",
        "border_color": "#232738",
        "accent_color": "#10b981"
    },
    "permissions": [
        { "key": "faqs.view", "label": "View FAQs Dashboard" },
        { "key": "faqs.create", "label": "Create New FAQs" },
        { "key": "faqs.edit", "label": "Edit Existing FAQs" },
        { "key": "faqs.delete", "label": "Delete FAQs" }
    ]
}