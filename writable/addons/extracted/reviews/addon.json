{
    "slug": "reviews",
    "name": "Student Reviews & Testimonial Slider",
    "category": "cms_widget",
    "version": "2.3.0",
    "author": "Core Architecture Team",
    "description": "Self-contained student reviews with Auto-Scroll (Smooth RTL/LTR Marquee & Fade-In/Fade-Out), Dual Dark/Light Theme Color Pickers, and Granular RBAC.",
    "admin_route": "addons/reviews",
    "frontend_route": "",
    "init_model": "App\\Models\\Addons\\Reviews\\ReviewModel",
    "assets": {
        "css": ["addons/reviews/assets/reviews.css"],
        "js": ["addons/reviews/assets/reviews.js"]
    },
    "default_config": {
        "badge": "WALL OF LOVE",
        "section_title": "What Parents & Students Say",
        "subtitle": "Real verified stories from our global learning community.",
        "category": "all",
        "columns": "3",
        "auto_scroll": "1",
        "anim_style": "smooth_scroll",
        "scroll_dir": "rtl",
        "scroll_speed": "28",
        "color_mode": "auto",
        "card_bg_dark": "#171a26",
        "text_dark": "#f8fafc",
        "star_dark": "#f59e0b",
        "card_bg_light": "#ffffff",
        "text_light": "#0f172a",
        "star_light": "#d97706"
    },
    "permissions": [
        { "key": "reviews.view", "label": "View Student Reviews Dashboard" },
        { "key": "reviews.create", "label": "Create New Student Reviews" },
        { "key": "reviews.edit", "label": "Edit & Approve Student Reviews" },
        { "key": "reviews.delete", "label": "Delete Student Reviews" }
    ]
}