        "color_mode": "auto",
        "bg_color": "#0d1f1a",
        "border_color": "#10b981",
        "text_color": "#f3f4f6",
        "btn_bg": "#10b981",
        "btn_text_col": "#04130d",
        "card_bg_light": "#ecfdf5",
        "text_light": "#064e3b"
    },
    "permissions": [
        { "key": "newsletter.view", "label": "View Newsletter Leads & Form Templates" },
        { "key": "newsletter.create", "label": "Create Form Templates & Add Leads" },
        { "key": "newsletter.edit", "label": "Edit Form Templates & Leads" },
        { "key": "newsletter.delete", "label": "Delete Form Templates & Leads" }
