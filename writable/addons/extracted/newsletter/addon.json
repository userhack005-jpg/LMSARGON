{
    "slug": "newsletter",
    "name": "Dynamic Newsletter & Lead Capture",
    "category": "cms_widget",
    "version": "4.1.0",
    "author": "Core Architecture Team",
    "description": "100% self-contained dynamic multi-form template & lead capture engine with automatic Page Builder schema, live template dropdown, CSV export, and granular RBAC.",
    "admin_route": "addons/newsletter",
